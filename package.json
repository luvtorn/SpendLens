{
  "name": "spendlens-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @spendlens/web",
    "dev:api": "npm run dev --workspace @spendlens/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @spendlens/api",
    "db:migrate": "npm run db:migrate --workspace @spendlens/api",
    "db:seed": "npm run db:seed --workspace @spendlens/api"
  }
}
